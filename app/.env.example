# Loaded automatically by npm start and npm run desktop (Node 24+).
# Keep simulated until credentials and the HTTPS callback tunnel are ready.
CALL_MODE=simulated
PORT=8787
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# New guided Voice trial: omit unsupported call options. Use false after upgrade.
TWILIO_TRIAL_MODE=false
# Only these E.164 demo recipients can be called; separate multiple entries with commas.
TWILIO_ALLOWED_TO=
# HTTPS tunnel origin, e.g. https://your-host.ngrok-free.app (no path).
TWILIO_CALLBACK_ORIGIN=
# DATA_DIR=./data

# Optional separate HTTPS origin for phone response pages (not the callback-only tunnel).
# PUBLIC_ORIGIN=
